{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build --turbopack",
    "ci": "biome ci",
    "create-admin": "doppler run --project=devoc-web --config=dev -- bun run scripts/create-admin.ts",
    "db:deploy": "doppler run -- bun x drizzle-kit migrate",
    "db:generate": "doppler run --project=devoc-web --config=dev -- bun x drizzle-kit generate",
    "db:migrate": "doppler run --project=devoc-web --config=dev -- bun x drizzle-kit migrate",
    "db:pull": "doppler run --project=devoc-web --config=dev -- bun x drizzle-kit pull",
    "db:push": "doppler run --project=devoc-web --config=dev -- bun x drizzle-kit push",
    "db:studio": "doppler run --project=devoc-web --config=dev -- bun x drizzle-kit studio",
    "dev": "doppler run --project=devoc-web --config=dev -- bun --bun next dev --turbopack -H 0.0.0.0",
    "format:fix": "biome format --write",
    "inngest": "doppler run --project=devoc-web --config=dev -- npx inngest-cli@latest dev",
    "lint": "bun x ultracite check",
    "lint:fix": "bun x ultracite fix",
    "seed-prospects": "doppler run --project=devoc-web --config=dev -- bun run scripts/seed-prospects.ts",
    "start": "bun --bun next start",
    "typecheck": "tsc --noEmit"
  },
