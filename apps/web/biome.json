{
  "root": false,
  "extends": "//",
  "linter": {
    "rules": {
      "style": {
        "noMagicNumbers": "off"
      },
      "correctness": {
        "useUniqueElementIds": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "useBaseline": "off"
          }
        }
      }
    }
  ]
}
