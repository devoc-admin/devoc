{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["DATABASE_URL", "VERCEL_BLOB_URL"],
      "passThroughEnv": [
        "BETTER_AUTH_SECRET",
        "BLOB_READ_WRITE_TOKEN",
        "INNGEST_EVENT_KEY",
        "INNGEST_SIGNING_KEY"
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
