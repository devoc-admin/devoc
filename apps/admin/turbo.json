{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "DATABASE_URL",
        "NEXT_PUBLIC_GOOGLE_MAPS_API_KEY",
        "VERCEL_BLOB_URL"
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
