{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "tui",
  "globalDependencies": [
    "biome.jsonc",
    "tooling/typescript-config/*.json",
    "package.json",
    "lefthook.yml"
  ],
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": ["DOPPLER_TOKEN"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "ci": {
      "dependsOn": ["^ci"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!.envrc",
        "!Justfile",
        "!.gitignore"
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
