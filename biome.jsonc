{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  // 🤝 Assist actions
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on",
        "useSortedAttributes": "on",
        "useSortedKeys": "on",
        "useSortedProperties": "on"
      }
    }
  },
  // 💾 Biome uses Git to check which files are changed or staged
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      // Remove preview apps
      "!**/preview",
      // 🧱 These components are pre-made components mostly copied/pasted from external registry so we don't want to apply to them linting rules
      "!**/components/ui",
      "!**/components/react-bits",
      "!**/components/fancy",
      "!**/components/aceternity",
      "!**/components/kibo-ui",
      "!**/components/sera-ui",
      "!**/components/magicui",
      "!**/components/tailgrids",
      "!**/components/motion-core",
      "!**/bilan",
      "!**/payload-types.ts",
      "!**/migrations",
      // 🖼️ SVG asset files are not source code — don't lint them as JSX
      "!**/*.svg",
      // 🩹 Biome 2.5.3's module-graph scanner panics (module_resolver.rs:500 index out of bounds) on any call to
      // startTransition from useTransition() — only this file uses it. Remove once fixed upstream.
      "!!apps/saveurs-aude/lib/auth.tsx"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "performance": {
        "noJsxPropsBind": "off" // Inline arrow functions in JSX props are our established style; React Compiler makes this micro-optimization obsolete
      },
      "style": {
        "useBlockStatements": "off", // No need to wrap every if statement in a block statement eg. if(!condition) return;
        "useConsistentTypeDefinitions": "off"
      }
    }
  },
  // 🌍 JavaScript globals for Chrome extension
  "javascript": {
    "globals": ["chrome"]
  },
  "extends": ["ultracite/biome/core", "ultracite/biome/next"]
}
